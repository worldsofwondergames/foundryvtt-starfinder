<ol class="crew-list">
    {{#each crew as |role|}}
    <li class="flexrow crew-header {{role.cssClass}}" {{#each role.dataset as |v k|}}data-{{k}}="{{v}}"{{/each}}>{{role.label}}</li>
    <ol class="crew-item-list">
        {{#each role.actors as |actor a|}}
        <li class="crew flexrow draggable" data-actor-id="{{actor.id}}">
            <div class="crew-name flexrow">
                <div class="crew-image" style="background-image: url({{actor.img}})"></div>
                <a class="crew-view"><h4>{{actor.name}}</h4></a>
            </div>
            <div class="crew-controls">
                {{#if (lookup (lookup @root.narrative.actable role.dataset.role) actor.id)}}
                <a class="crew-control narrative-act" data-role="{{role.dataset.role}}" title="{{localize "SFRPG.NarrativeStarship.Act"}}"><i class="fas fa-dice-d20"></i> {{localize "SFRPG.NarrativeStarship.Act"}}</a>
                {{/if}}
                <a class="crew-control crew-delete" title="{{localize "SFRPG.StarshipSheet.Crew.RemoveCrewMember"}}"><i class="fas fa-trash"></i></a>
            </div>
        </li>
        {{/each}}
    </ol>
    {{/each}}
</ol>
