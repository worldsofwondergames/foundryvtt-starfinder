<form class="{{cssClass}} flexcol" autocomplete="off">

    {{!-- Item Sheet Header --}}
    <header class="sheet-header flexrow">
        <img class="profile" src="{{item.img}}" title="{{item.name}}" data-edit="img" />

        <div class="header-details flexrow">
            <h1 class="charname">
                <input name="name" type="text" value="{{item.name}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.ItemName" }}" />
            </h1>

            <div class="item-subtitle">
                <h4 class="item-type">{{ localize "TYPES.Item.mechUpgrade" }}</h4>
                <span class="item-status">{{itemStatus}}</span>
            </div>

            {{!-- Item Summary --}}
            <ul class="summary flexrow">
                <li class="wide" data-tooltip="{{ localize "SFRPG.ItemSheet.Header.SourceTooltip" }}">
                <input type="text" name="system.source" value="{{itemData.source}}" placeholder="{{ localize "SFRPG.ItemSheet.Header.Source" }}"/>
                </li>
            </ul>

        </div>

    </header>

    {{!-- Item Sheet Navigation --}}
    <nav class="sheet-navigation tabs" data-group="primary">
        <a class="item active" data-tab="description">{{ localize "SFRPG.Description" }}</a>
        <a class="item" data-tab="details">{{ localize "SFRPG.Details" }}</a>
    </nav>

    {{!-- Item Sheet Body --}}
    <section class="sheet-body">

        {{!-- Description Tab --}}
        {{> "systems/sfrpg/templates/items/parts/item-description.hbs"}}

        {{!-- Details Tab --}}
        <div class="tab details" data-group="primary" data-tab="details">

            <div class="bubble">
                <h3 class="bubble-header">{{ localize "SFRPG.Details" }}</h3>
                <div class="bubble-info">
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Upgrade.MpCost" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.mpCost" value="{{itemData.mpCost}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Upgrade.CoreTemplate" }}</label>
                        <div class="form-fields">
                            <input type="checkbox" name="system.coreTemplate" {{checked itemData.coreTemplate}} />
                        </div>
                    </div>
                    {{#if itemData.coreTemplate}}
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Upgrade.PpRegenBonus" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.ppRegenBonus" value="{{itemData.ppRegenBonus}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Upgrade.PpInitialBonus" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.ppInitialBonus" value="{{itemData.ppInitialBonus}}" data-dtype="Number" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Upgrade.PpMaxBonus" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.ppMaxBonus" value="{{itemData.ppMaxBonus}}" data-dtype="Number" />
                        </div>
                    </div>
                    {{else}}
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Upgrade.Repeatable" }}</label>
                        <div class="form-fields">
                            <input type="checkbox" name="system.repeatable" {{checked itemData.repeatable}} />
                        </div>
                    </div>
                    {{#if itemData.repeatable}}
                    <div class="form-group">
                        <label>{{ localize "SFRPG.MechSheet.Upgrade.RepeatCostStep" }}</label>
                        <div class="form-fields">
                            <input type="text" name="system.repeatCostStep" value="{{itemData.repeatCostStep}}" data-dtype="Number" />
                        </div>
                    </div>
                    {{/if}}
                    {{/if}}
                </div>
            </div>

        </div>

    </section>
</form>
